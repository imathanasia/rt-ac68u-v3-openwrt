diff --git a/target/linux/bcm53xx/image/Makefile b/target/linux/bcm53xx/image/Makefile
index 8f193a3..3bf349b 100644
--- a/target/linux/bcm53xx/image/Makefile
+++ b/target/linux/bcm53xx/image/Makefile
@@ -212,6 +212,18 @@ define Device/asus_rt-ac68u
 endef
 TARGET_DEVICES += asus_rt-ac68u
 
+# ASUS RT-AC68U V3: the newer Northstar die (bcma chip 53030, BCM47094
+# family, package 0x02) with a BCM53011 switch, as read from a running
+# unit.  The upstream RT-AC68U DTS targets the older 53010 die.
+define Device/asus_rt-ac68u-v3
+  $(call Device/asus)
+  DEVICE_MODEL := RT-AC68U
+  DEVICE_VARIANT := V3
+  DEVICE_PACKAGES := $(USB3_PACKAGES)
+  ASUS_PRODUCTID := RT-AC68U
+endef
+TARGET_DEVICES += asus_rt-ac68u-v3
+
 define Device/asus_rt-ac87u
   $(call Device/asus)
   DEVICE_MODEL := RT-AC87U
