@@ -1,3 +1,19 @@
+
+{# Router project badge on every page #}
+<script>
+document.addEventListener("luci-loaded", function() {
+	if (document.getElementById("router-badge"))
+		return;
+	var a = document.createElement("a");
+	a.id = "router-badge";
+	a.href = "/cgi-bin/luci/admin/services/router";
+	a.textContent = "\u2605 Router project";
+	a.style.cssText = "position:fixed;right:14px;bottom:10px;z-index:900;font-size:12px;" +
+		"padding:4px 9px;border-radius:99px;background:#1b2433;color:#9fc4ff;" +
+		"border:1px solid #2d3a55;text-decoration:none;opacity:.85";
+	document.body.appendChild(a);
+});
+</script>
