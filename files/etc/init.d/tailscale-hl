#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
DIR=/opt/tailscale
BIN=/tmp/tailscaled
start_service() {
	[ -f "$DIR/enabled" ] || return 0
	if [ ! -x "$BIN" ] && [ -f "$DIR/tailscaled.gz" ]; then
		zcat "$DIR/tailscaled.gz" > "$BIN" 2>/dev/null || return 0
		chmod +x "$BIN"
	fi
	[ -x "$BIN" ] || return 0
	mkdir -p "$DIR/state"
	procd_open_instance
	procd_set_param command "$BIN" --state="$DIR/state/tailscaled.state" --socket=/tmp/tailscaled.sock --port=41641
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
