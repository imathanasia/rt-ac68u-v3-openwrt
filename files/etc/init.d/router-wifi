#!/bin/sh /etc/rc.common
# Wireless bring-up for the b43 AC-PHY boards (RT-AC68U V3, R7000).
#
# The b43 AC-PHY driver registers both radios about 15 s after boot.  OpenWrt
# generates /etc/config/wireless when a phy shows up, but the generated AP
# interfaces are disabled, so the radios stay up and idle: "iw dev" shows
# nothing and no AP is broadcast until something configures them.  This
# service does that once, on the first boot.
#
# Both supported boards pair a Broadcom 47xx-era SoC with two BCM4360
# (d11 core rev 42, AC-PHY rev 1, radio 0x2069 rev 4), femctrl 6.
#   radio0 = 2.4 GHz 3x3  -> HT20,  channel 1
#   radio1 = 5 GHz   3x3  -> VHT80, channel 36 (5180 MHz)
#
# Settings live in /etc/router-wifi.conf (SSID / KEY / COUNTRY / channels).
# A placeholder key is shipped - change it before exposing the AP.

START=95
STOP=10
USE_PROCD=1

wait_for_radios() {
	# b43 needs the core-rev-42 firmware; give it up to 3 minutes.
	i=0
	while [ "$i" -lt 90 ]; do
		n=$(ls -d /sys/class/ieee80211/phy* 2>/dev/null | wc -l)
		[ "$n" -ge 2 ] && { sleep 2; return 0; }
		sleep 2
		i=$((i + 1))
	done
	return 1
}

radio_band() {
	# "2g" or "5g" for this wifi-device
	uci -q get wireless.$1.band
}

setup_wifi() {
	. /lib/functions.sh

	CONF=/etc/router-wifi.conf
	[ -f "$CONF" ] || return 1
	. "$CONF"

	[ -f /etc/config/wireless ] || wifi config
	[ -f /etc/config/wireless ] || return 1

	for dev in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band=$(radio_band "$dev")
		case "$band" in
		2g)
			uci -q set wireless.$dev.disabled='0'
			uci -q set wireless.$dev.country="${COUNTRY:-PL}"
			uci -q set wireless.$dev.htmode='HT20'
			uci -q set wireless.$dev.channel="${CH_2G:-1}"
			uci -q set wireless.$dev.encryption='psk2'
			uci -q set wireless.$dev.key="$KEY"
			;;
		5g)
			uci -q set wireless.$dev.disabled='0'
			uci -q set wireless.$dev.country="${COUNTRY:-PL}"
			uci -q set wireless.$dev.htmode="${HTMODE_5G:-VHT80}"
			uci -q set wireless.$dev.channel="${CH_5G:-36}"
			uci -q set wireless.$dev.encryption='psk2'
			uci -q set wireless.$dev.key="$KEY"
			;;
		esac
	done

	# The generated AP interfaces are named default_radioN.
	for dev in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band=$(radio_band "$dev")
		n=${dev#radio}
		iface="default_radio$n"
		[ "$(uci -q get wireless.$iface.mode)" = "ap" ] || continue
		case "$band" in
		2g) name="${SSID}-2G" ;;
		5g) name="${SSID}-5G" ;;
		*)   name="$SSID" ;;
		esac
		uci -q set wireless.$iface.disabled='0'
		uci -q set wireless.$iface.ssid="$name"
		uci -q set wireless.$iface.encryption='psk2'
		uci -q set wireless.$iface.key="$KEY"
	done

	uci commit wireless
	wifi reload
	logger -t router-wifi "configured ${SSID}-2G (ch ${CH_2G:-1} HT20) and ${SSID}-5G (ch ${CH_5G:-36} ${HTMODE_5G:-VHT80})"
}

start_service() {
	# Only the two supported b43 AC-PHY boards are configured here.
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		asus,rt-ac68u-v3|netgear,r7000) ;;
		*) return 0 ;;
	esac

	( wait_for_radios && setup_wifi ) >/dev/null 2>&1 &
}
