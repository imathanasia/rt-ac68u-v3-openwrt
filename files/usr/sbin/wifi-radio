#!/bin/sh
# On-demand Wi-Fi (RT-AC68U V3 / R7000): nothing is transmitted unless asked.
set -u
case "${1:-status}" in
on)
	/etc/init.d/router-wifi enable
	/etc/init.d/router-wifi start
	logger -t wifi-radio "radios on"
	;;
off)
	/etc/init.d/router-wifi stop 2>/dev/null
	/etc/init.d/router-wifi disable 2>/dev/null
	wifi down 2>/dev/null
	logger -t wifi-radio "radios off"
	;;
status)
	svc=$(/etc/init.d/router-wifi enabled && echo enabled || echo disabled)
	echo "service: $svc"
	for p in /sys/class/ieee80211/phy*; do
		[ -e "$p" ] || continue
		echo "phy: $(basename $p) $(cat $p/name 2>/dev/null)"
	done
	if command -v iwinfo >/dev/null 2>&1; then
		iwinfo 2>/dev/null | sed -n 's/^\([^ ][^ ]*\)  *ESSID: /iface: \1  ESSID: /p'
	else
		iw dev 2>/dev/null | sed -n 's/^Interface /iface: /p'
	fi
	;;
*)
	echo "usage: wifi-radio on|off|status" >&2
	exit 1
	;;
esac
